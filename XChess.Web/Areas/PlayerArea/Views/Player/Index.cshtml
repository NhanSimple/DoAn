@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "XChess";
}

@section Styles {
    <style>
       
    </style>
}

<div class="d-flex flex-column align-items-center justify-content-center position-relative">

    <!-- Các nút chức năng -->
    <div class="btn-wrapper d-flex flex-column align-items-center gap-3" id="main-flex-container">
        <button class="btn btn-outline-light chess-button" >Chơi với người</button>
        <button class="btn btn-primary chess-button"   onclick="location.href='@Url.Action("Index", "PVE", new { area = "PVEArea" })'">Chơi với máy</button>
        <button class="btn btn-success chess-button">Hướng dẫn chơi</button>
        <button class="btn btn-outline-light chess-button">Lịch sử đấu</button>
        <button class="btn btn-outline-light chess-button">Cài đặt</button>
        <button class="btn btn-dark chess-button btn-dark-icon">♟</button>
    </div>
</div>
