@using Newtonsoft.Json

@{
    string userName = "Guest";

    if (User.Identity.IsAuthenticated)
    {
        try
        {
            dynamic userData = JsonConvert.DeserializeObject(User.Identity.Name);
            userName = userData?.Name ?? "Guest";
        }
        catch
        {
            userName = "Guest";
        }
    }
}


<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>XChess</title>
    @Styles.Render("~/Content/css")
    @Styles.Render("~/Content/play/css")
    @Scripts.Render("~/bundles/modernizr")
    @RenderSection("styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3">
        <a class="navbar-brand" href="#">XChess</a>
        <div class="ms-auto d-flex align-items-center">
            @if (User.Identity.IsAuthenticated)
            {
                <div class="dropdown">
                    <button class="btn btn-outline-light dropdown-toggle btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span>👤 @userName</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#">Profile</a></li>
                        <li><a class="dropdown-item" href="#">Settings</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item text-danger" href="@Url.Action("Logout", "Login", new { area = "" })">Logout</a>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </nav>
    <div id="toast-container"></div>

    <div id="layout-wrapper">
        <div class="main-content">
            <div class="page-content">
                <div class="page-header">


                </div>
                <div>
                    @RenderBody()
                </div>
                <!-- HỘP THOẠI PHONG TỐT -->
                <div id="promotion-dialog" class="promotion-dialog hidden">
                    <div class="promotion-options">
                        <img data-piece="q" src="/Content/Images/wq.svg" />
                        <img data-piece="r" src="/Content/Images/wr.svg" />
                        <img data-piece="b" src="/Content/Images/wb.svg" />
                        <img data-piece="n" src="/Content/Images/wn.svg" />
                    </div>
                </div>
                <div id="MasterModal" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static" style="z-index:1051">
                </div>
            </div>

        </div>
        @Html.Partial("_ModalPartial")
    </div>
    @Scripts.Render("~/bundles/jquery")

    @Scripts.Render("~/assets/appjs")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/Scripts/Chessjs")
    @Scripts.Render("~/Scripts/ChessBoardjs")
    @RenderSection("scripts", required: false)


</body>
</html>